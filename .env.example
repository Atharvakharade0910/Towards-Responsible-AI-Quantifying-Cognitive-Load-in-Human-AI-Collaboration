GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=sk_your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_NUM_PREDICT=500
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=30m
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8001,http://localhost:8001,http://127.0.0.1:8002,http://localhost:8002
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
HOST_USERNAME=host
HOST_PASSWORD=replace-with-a-long-random-host-password
DASHBOARD_USERNAME=dashboard
DASHBOARD_PASSWORD=replace-with-a-long-random-dashboard-password
TOKEN_TTL_MINUTES=60

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=assessments@example.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000
DATABASE_URL=postgresql://cognitrack:replace-password@127.0.0.1:5432/AtharvaDB

# Use a long random value so participant tokens remain valid across backend restarts.
PARTICIPANT_TOKEN_SECRET=replace-with-a-long-random-secret
